# Mediajanitor environment variable overrides.
# Copy to .env and source it, or set these in your shell/systemd unit.
# All vars prefixed MEDIAJANITOR_ map to their config.yaml equivalents.

MEDIAJANITOR_DOWNLOADS_ROOT=/downloads

MEDIAJANITOR_SONARR_URL=http://localhost:8989
MEDIAJANITOR_SONARR_API_KEY=your_sonarr_api_key_here

MEDIAJANITOR_RADARR_URL=http://localhost:7878
MEDIAJANITOR_RADARR_API_KEY=your_radarr_api_key_here

MEDIAJANITOR_QBITTORRENT_URL=http://localhost:8080
MEDIAJANITOR_QBITTORRENT_USERNAME=admin
MEDIAJANITOR_QBITTORRENT_PASSWORD=your_password_here

# Optional: override database and config locations
# MEDIAJANITOR_DB_PATH=$XDG_DATA_HOME/mediajanitor/data.db
# MEDIAJANITOR_LOG_FORMAT=json
